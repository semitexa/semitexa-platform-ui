{
    "name": "semitexa/platform-ui",
    "description": "Semitexa Platform UI \u2014 LLM-friendly CSS grammar, design tokens, primitive components, and AI-assisted skin generation (SkinResolver: LLM prompt resolver feeding semitexa/theme's skin generator, plus refinement and eval scorer). Requires semitexa/theme for SkinAlgorithm contract.",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/authorization": "*",
        "semitexa/core": ">=2026.10.14.0919 || dev-master",
        "semitexa/llm": ">=2026.10.08.0620 || dev-master",
        "semitexa/ssr": ">=2026.10.19.0811 || dev-master",
        "semitexa/theme": ">=2026.10.14.0919 || dev-master",
        "symfony/console": "^7.0",
        "semitexa/prompt": "*",
        "semitexa/platform-user": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\PlatformUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\PlatformUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa": {
            "floors": {
                "semitexa/core": "2026.10.14.0919",
                "semitexa/ssr": "2026.10.19.0811",
                "semitexa/llm": "2026.10.08.0620",
                "semitexa/theme": "2026.10.14.0919"
            }
        },
        "semitexa-module": {
            "name": "platform-ui",
            "description": "LLM-friendly CSS grammar + design tokens + UI primitives + AI-assisted skin generation (SkinResolver \u2192 theme)",
            "template_paths": [
                "resources/twig"
            ]
        }
    },
    "keywords": [
        "semitexa",
        "ui",
        "css",
        "design-tokens",
        "platform"
    ]
}
