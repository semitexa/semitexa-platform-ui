{#- platform.forgot-password — props: submitAction, title, signInHref. -#}
{% set _fields %}
    {{ component('platform.field', {label: 'Email', name: 'email', required: true, showValidationTarget: true, rules: ['required'], inputProps: {type: 'email', autocomplete: 'email', autofocus: true}}) }}
{% endset %}
<div data-ui-component="platform.forgot-password" ui-auth-form sx-layout="stack" sx-gap="4">
    <h1 ui-text="title" style="font-size:1.375rem;margin:0;">{{ title|default('Reset your password') }}</h1>
    <p ui-text="muted" style="margin:0;">Enter your email and we will send you a link to choose a new password.</p>
    {{ component('platform.form', {
        showStatus: true, statusInitialMessage: '', showSubmit: true, submitText: 'Send the link',
        autoFields: true, submitAction: submitAction, ariaLabel: title|default('Reset your password'),
    }, {content: _fields}) }}
    {% if signInHref|default('') %}<div ui-auth-links><a href="{{ signInHref }}">Back to sign in</a></div>{% endif %}
</div>
