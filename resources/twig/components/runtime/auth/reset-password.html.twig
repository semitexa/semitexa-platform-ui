{#- platform.reset-password — props: submitAction, token (signed into the form), title, minPassword, signInHref (where the ready action sends the browser after a reset). -#}
{%- set _min = minPassword|default(12) -%}
{% set _fields %}
    {{ component('platform.field', {
        label: 'New password', name: 'password', help: 'At least ' ~ _min ~ ' characters.',
        required: true, showValidationTarget: true, rules: ['required', ['minLength', _min]],
        inputProps: {type: 'password', autocomplete: 'new-password', autofocus: true},
    }) }}
    {{ component('platform.field', {
        label: 'Repeat the new password', name: 'password_confirmation',
        required: true, showValidationTarget: true, rules: ['required', ['sameAsField', 'password', 'The passwords do not match.']],
        inputProps: {type: 'password', autocomplete: 'new-password'},
    }) }}
{% endset %}
<div data-ui-component="platform.reset-password" ui-auth-form sx-layout="stack" sx-gap="4">
    <h1 ui-text="title" style="font-size:1.375rem;margin:0;">{{ title|default('Choose a new password') }}</h1>
    {{ component('platform.form', {
        showStatus: true, statusInitialMessage: '', showSubmit: true, submitText: 'Save the password',
        autoFields: true, submitAction: submitAction, token: token, signInHref: signInHref|default(''), ariaLabel: title|default('Choose a new password'),
    }, {content: _fields}) }}
</div>
{#- The token is in this page's URL: from here on no request to another site carries it as its Referer. same-origin, not no-referrer: the page's own live streams are refused without an Origin or Referer. After the root element, which the component annotator writes to. Requests the head made before it need the route's own Referrer-Policy header. -#}
<meta name="referrer" content="same-origin">
