{#
 # platform.card — layout only. Places caller slot content (media, header,
 # body, footer) into a token-styled surface. No parts, no events.
 #
 # Header falls back to the `title` / `subtitle` props when the `header`
 # slot is empty. `variant` = elevated (default) | outlined | plain.
 # Slots: media, header, body, footer
 #}
{%- set _variant = variant|default('elevated') -%}
{%- set _media = slot('media')|trim -%}
{%- set _header = slot('header')|trim -%}
{%- set _body = slot('body')|trim -%}
{%- set _footer = slot('footer')|trim -%}
{%- set _has_title = title|default(null) is not null and title != '' -%}
<div data-ui-component="platform.card" ui-component="card"{% if variant|default(null) %} ui-variant="{{ _variant }}"{% endif %}>
{%- if _media %}<div ui-card="media">{{ _media|raw }}</div>{% endif -%}
{%- if _header or _has_title %}
    <div ui-card="header">
        {%- if _header %}{{ _header|raw }}
        {%- else %}
            <div ui-card="title">{{ title }}</div>
            {%- if subtitle|default(null) %}<div ui-card="subtitle">{{ subtitle }}</div>{% endif -%}
        {%- endif -%}
    </div>
{%- endif -%}
{%- if _body %}<div ui-card="body">{{ _body|raw }}</div>{% endif -%}
{%- if _footer %}<div ui-card="footer">{{ _footer|raw }}</div>{% endif -%}
</div>
