{#
 # @platform-ui/layouts/auth.html.twig — sign in, sign up, password reset:
 # one centred card, no application chrome.
 #
 #   {% extends '@platform-ui/layouts/auth.html.twig' %}
 #   {% set appName = 'Admin' %}
 #   {% block main %}{{ component('platform.sign-in', {submitAction: 'app.auth.sign-in'}) }}{% endblock %}
 #
 # Variables: appName, appHome (brand link), appViewTransitions (cross-fade to
 # and from the app's app-shell pages — set it where the app shell sets it).
 # Blocks: title, head_extra, brand, main, aside (below the card), footer.
 #}
<!doctype html>
<html lang="{{ locale()|default('en')|e('html_attr') }}" data-theme="{{ theme_info().theme|default('') }}" data-skin="{{ theme_info().skin|default('') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ page_title()|default(title|default(appName|default('Semitexa'))) }}{% endblock %}</title>
    {{ asset_require('platform-ui:css:auth') }}
    {% include '@project-layouts-theme-base/partials/head/theme-switcher.html.twig' ignore missing %}
    {{ semantic_head() }}
    {{ asset_head() }}
    <link rel="stylesheet" href="{{ theme_skin_css() }}">
    {{ inject_scripts('head') }}
    {% include '@platform-ui/layouts/_view-transitions.html.twig' %}
    {% block head_extra %}{{ layout_slot('head_extra') }}{% endblock %}
</head>
<body ui-auth-shell data-app-home="{{ appHome|default('/') }}"{{ __ssr_handle_attr|default('')|raw }}>
    <main ui-auth-main>
        <div ui-auth-brand>{% block brand %}<a href="{{ appHome|default('/') }}">{{ appName|default('Semitexa') }}</a>{% endblock %}</div>
        <div ui-auth-card>
            {% block main %}{{ main|default(content|default(''))|raw }}{% endblock %}
        </div>
        <div ui-auth-aside>{% block aside %}{% endblock %}</div>
        <footer ui-auth-footer>{% block footer %}{{ layout_slot('footer') }}{% endblock %}</footer>
    </main>
    {{ asset_body() }}
    {{ inject_scripts('body') }}
</body>
</html>
