<div ui-behavior="accordion" ui-accordion="{{ opts }}">
    <div ui-behavior-item>
        <button ui-behavior-toggle type="button">What is Semitexa Platform?</button>
        <div ui-behavior-content hidden>The UI layer of Semitexa: server-rendered components that stay live.</div>
    </div>
    <div ui-behavior-item>
        <button ui-behavior-toggle type="button">Does it need a build step?</button>
        <div ui-behavior-content hidden>No. Native ES modules and CSS cascade layers.</div>
    </div>
    <div ui-behavior-item>
        <button ui-behavior-toggle type="button">Can I bring my own skin?</button>
        <div ui-behavior-content hidden>Yes: one seed colour generates a full light and dark skin.</div>
    </div>
</div>
