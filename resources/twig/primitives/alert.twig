{# @platform-ui/alert — contextual message box (tone + optional icon/title) #}
{% macro render(text, options = {}) %}
    {%- set tone = options.tone|default('info') -%}
    {%- set title = options.title|default(null) -%}
<div ui="alert"{% if options.tone|default(null) %} ui-tone="{{ tone }}"{% endif %} role="{{ (tone == 'danger' or tone == 'warning') ? 'alert' : 'status' }}">
    <div data-alert-body>
        {%- if title %}<div data-alert-title>{{ title }}</div>{% endif -%}
        {{ text }}
    </div>
</div>
{% endmacro %}
