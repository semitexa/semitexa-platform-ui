{#- platform.badge — props: text, variant (soft|solid|outline), tone, size (sm|md), dot, icon. #}
<span ui="{{ _primitive.ui }}" data-ui-primitive="{{ _primitive.name }}"
{%- if variant|default(null) %} ui-variant="{{ variant }}"{% endif -%}
{%- if tone|default(null) %} ui-tone="{{ tone }}"{% endif -%}
{%- if size|default(null) %} ui-size="{{ size }}"{% endif -%}
{%- if dot|default(false) %} ui-dot{% endif -%}
>{% if icon|default(null) %}{{ icon(icon) }}{% endif %}{{ text|default('') }}</span>
