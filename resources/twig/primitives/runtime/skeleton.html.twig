{#- platform.skeleton — shape (text|circle|rect), lines, width, height. Decorative: aria-hidden. -#}
{%- set _shape = shape|default('text') -%}
{%- set _style = (width|default('') ? '--_w:' ~ width ~ ';' : '') ~ (height|default('') ? '--_h:' ~ height ~ ';' : '') -%}
<span ui="{{ _primitive.ui }}" data-ui-primitive="{{ _primitive.name }}" ui-shape="{{ _shape }}" aria-hidden="true"{% if _style %} style="{{ _style }}"{% endif %}>
{%- if _shape == 'text' -%}
{%- for i in 1..max(1, lines|default(1)) %}<span ui-skeleton-line></span>{% endfor -%}
{%- endif -%}
</span>
