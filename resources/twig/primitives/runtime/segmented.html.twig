{#- platform.segmented — name, options [{value, label, icon?}], value, label, size, iconOnly. A radio group drawn as one button bar.
    iconOnly keeps each label in the DOM (visually hidden) as its radio's accessible name, and as a tooltip. -#}
{%- set _iconOnly = iconOnly ?? false -%}
{%- set _value = (value ?? '') ~ '' -%}
<fieldset ui="{{ _primitive.ui }}" data-ui-primitive="{{ _primitive.name }}"
{%- if part|default(null) %} data-ui-part="{{ part }}"{% endif -%}
{%- if size|default(null) %} ui-size="{{ size }}"{% endif -%}
{%- if label|default(null) %} aria-label="{{ label }}"{% endif -%}
{%- if _iconOnly %} ui-icon-only{% endif -%}
>
{%- for option in options|default([]) -%}
<label{% if _iconOnly %} title="{{ option.label|default(option.value) }}"{% endif %}><input type="radio" name="{{ name|default('') }}" value="{{ option.value }}"{% if (option.value ~ '') == _value %} checked{% endif %}>
{%- if option.icon ?? null %}{{ icon(option.icon, {size: 16}) }}{% endif -%}
<span>{{ option.label|default(option.value) }}</span></label>
{%- endfor -%}
</fieldset>
