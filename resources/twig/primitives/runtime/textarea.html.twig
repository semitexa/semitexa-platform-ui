{#- platform.textarea -#}
<textarea ui="{{ _primitive.ui }}" data-ui-primitive="{{ _primitive.name }}" rows="{{ rows|default(4) }}"
{%- if part|default(null) %} data-ui-part="{{ part }}"{% endif -%}
{%- if name|default(null) %} name="{{ name }}"{% endif -%}
{%- if id|default(null) %} id="{{ id }}"{% endif -%}
{%- if size|default(null) %} ui-size="{{ size }}"{% endif -%}
{%- if placeholder|default(null) %} placeholder="{{ placeholder }}"{% endif -%}
{%- if required|default(false) %} required{% endif -%}
{%- if disabled|default(false) %} disabled{% endif -%}
{%- if aria_invalid|default(null) %} aria-invalid="true"{% endif -%}
{%- if aria_describedby|default(null) %} aria-describedby="{{ aria_describedby }}"{% endif -%}
>{{ value|default('') }}</textarea>
